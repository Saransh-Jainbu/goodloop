// OWNER: Aditya
enum Cause {
  ENVIRONMENT
  EDUCATION
  HEALTH
  COMMUNITY
  ANIMALS
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String
  cause       Cause       @default(OTHER)
  startsAt    DateTime
  endsAt      DateTime?
  address     String
  lat         Float
  lng         Float
  capacity    Int?
  status      EventStatus @default(PUBLISHED)
  organiserId String
  organiser   User        @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  registrations Registration[]
}
