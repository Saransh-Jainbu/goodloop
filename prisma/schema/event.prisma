// Planned fields: description, cause, startsAt, endsAt, address, lat, lng, capacity, status
enum Cause {
  ENVIRONMENT
  EDUCATION
  HEALTH
  COMMUNITY
  ANIMALS
  OTHER
}

model Event {
  id          String   @id @default(cuid())
  title       String
  cause       Cause    @default(OTHER)
  organiserId String
  organiser   User     @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  registrations Registration[]
}
