# Copy to .env (never commit real values)

# Neon Postgres (console.neon.tech -> Connection details)
# Pooled host (contains "-pooler") for the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct host (no "-pooler") for Prisma migrations:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Used by prisma/seed.ts (dev only)
SEED_ADMIN_EMAIL="admin@goodloop.test"
SEED_ADMIN_PASSWORD="change-me-123"
